{
  "manifest_version": 3,
  "name": "115 磁力分析助手",
  "version": "1.2.0",
  "description": "javdb/javbus 磁力分析：自动查重（番号xxx已存在）、一键转存115、下载并上传封面、完成后重命名最大文件",
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://javdb.com/*",
        "https://*.javdb.com/*",
        "https://javbus.com/*",
        "https://*.javbus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "115 磁力分析助手",
    "default_popup": "popup.html"
  }
}
